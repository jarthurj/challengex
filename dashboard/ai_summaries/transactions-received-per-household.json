      "summary": {
        "headline": "Long-term trends across all demographic segments show significant declines in transactions mail received per household from FY2003 and FY2014 through FY2023.",
        "statements": [
          {
            "text": "For all households, transactions mail received per household fell by 161.2 pieces per household per year, or 58.5 percent, from FY2003 to FY2023 across the FY2010, FY2012, FY2013, FY2014, FY2015, and FY2017 methodology breaks.",
            "metric": "transactions-received-per-household",
            "years": [
              2003,
              2023
            ]
          },
          {
            "text": "For all households, transactions mail received per household decreased by 104.0 pieces per household per year, or 47.6 percent, from FY2013 to FY2023 across the FY2014, FY2015, and FY2017 methodology breaks.",
            "metric": "transactions-received-per-household",
            "years": [
              2013,
              2023
            ]
          },
          {
            "text": "For all households, transactions mail received per household declined by 31.2 pieces per household per year, or 21.4 percent, from FY2018 to FY2023.",
            "metric": "transactions-received-per-household",
            "years": [
              2018,
              2023
            ]
          },
          {
            "text": "For $35K to $65K, transactions mail received per household dropped by 114.4 pieces per household per year, or 52.4 percent, from FY2014 to FY2023 across the FY2015 and FY2017 methodology breaks.",
            "metric": "transactions-received-per-household",
            "years": [
              2014,
              2023
            ]
          },
          {
            "text": "For Over $100K, transactions mail received per household decreased by 166.4 pieces per household per year, or 58.2 percent, from FY2014 to FY2023 across the FY2015 and FY2017 methodology breaks.",
            "metric": "transactions-received-per-household",
            "years": [
              2014,
              2023
            ]
          },
          {
            "text": "For Under $35K, transactions mail received per household fell by 93.6 pieces per household per year, or 56.2 percent, from FY2014 to FY2023 across the FY2015 and FY2017 methodology breaks.",
            "metric": "transactions-received-per-household",
            "years": [
              2014,
              2023
            ]
          },
          {
            "text": "For Under 35, transactions mail received per household dropped by 88.4 pieces per household per year, or 60.7 percent, from FY2014 to FY2023 across the FY2015 and FY2017 methodology breaks.",
            "metric": "transactions-received-per-household",
            "years": [
              2014,
              2023
            ]
          }
        ],
        "caveats": [
          "Projections need at least 8 consecutive annual values; this series has fewer, so none is shown.",
