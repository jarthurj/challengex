    "comparative": {
      "section": "First-Class Mail received by category",
      "kind": "comparative",
      "key": "comparative",
      "fiscal_year": null,
      "fiscal_year_range": null,
      "summary": {
        "headline": "First-Class Mail received by category: long-term change in the published values, FY2000 to FY2023.",
        "statements": [
          {
            "text": "First-Class advertising received (ads only) (millions of pieces) went from 9,471 in FY2000 to 3,236 in FY2023: it fell by 6,235 (65.8%) over the period. Since FY2018 (five years earlier) it fell by 268 (7.6%). Since FY2013 (ten years earlier) it fell by 1,004 (23.7%).",
            "metric": "fcm-received-advertising",
            "years": [
              2000,
              2023,
              2018,
              2013
            ]
          },
          {
            "text": "Projection, not a published figure: the Naive (last value) model, fitted on FY2010 to FY2023, puts First-Class advertising received (ads only) at 3,236 in FY2028 (80% range 2,658 to 3,814). On past years it did not beat the naive baseline.",
            "metric": "fcm-received-advertising",
            "years": [
              2023,
              2028
            ]
          },
          {
            "text": "First-Class correspondence received (millions of pieces) went from 19,470 in FY2000 to 12,864 in FY2023: it fell by 6,606 (33.9%) over the period. Since FY2018 (five years earlier) it fell by 1,911 (12.9%). Since FY2013 (ten years earlier) it fell by 2,633 (17.0%).",
            "metric": "fcm-received-correspondence",
            "years": [
              2000,
              2023,
              2018,
              2013
            ]
          },
          {
            "text": "Projection, not a published figure: the Linear trend model, fitted on FY2010 to FY2023, puts First-Class correspondence received at 12,113 in FY2028 (80% range 11,509 to 12,717). On past years it beat the naive baseline.",
            "metric": "fcm-received-correspondence",
            "years": [
              2023,
              2028
            ]
          },
          {
            "text": "First-Class transaction mail received (millions of pieces) went from 24,514 in FY2000 to 14,879 in FY2023: it fell by 9,635 (39.3%) over the period. Since FY2018 (five years earlier) it fell by 4,017 (21.3%). Since FY2013 (ten years earlier) it fell by 6,633 (30.8%).",
            "metric": "fcm-received-transactions",
            "years": [
              2000,
              2023,
              2018,
              2013
            ]
          },
          {
            "text": "Projection, not a published figure: the Holt's exponential smoothing model, fitted on FY2010 to FY2023, puts First-Class transaction mail received at 11,387 in FY2028 (80% range 9,454 to 13,320). On past years it beat the naive baseline.",
            "metric": "fcm-received-transactions",
            "years": [
              2023,
              2028
            ]
          }
        ],
        "caveats": [
          "Methodology change in FY2010: Diary data restated with new weighting. Comparisons across it should be cautious."
        ]
      },
