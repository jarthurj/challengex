            "years": [
              2023,
              2022,
              2018
            ]
          },
          {
            "text": "In FY2023, First-Class transaction mail received was 14,879 (millions of pieces). That fell by 27 (0.2%) from the previous year, FY2022. That fell by 4,017 (21.3%) from five years earlier, FY2018.",
            "metric": "fcm-received-transactions",
            "years": [
              2023,
              2022,
              2018
            ]
          }
        ],
