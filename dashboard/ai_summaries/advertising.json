      "summary": {
        "headline": "Advertising: published values for FY2020 and how they moved.",
        "statements": [
          {
            "text": "In FY2020, First-Class and Marketing Mail ads received per household was 487.7 (pieces per household per year). That fell by 155.9 (24.2%) from five years earlier, FY2015.",
            "metric": "ads-received-per-household",
            "years": [
              2020,
              2015
            ]
          },
          {
            "text": "In FY2020, Advertising mail received per household was 478.4 (pieces per household per year). That fell by 88.4 (15.6%) from the previous year, FY2019. That fell by 150.8 (24.0%) from five years earlier, FY2015.",
            "metric": "advertising-mail-received-per-household",
            "years": [
              2020,
              2019,
              2015
            ]
          },
          {
            "text": "In FY2020, Advertising mail per household was 502.9 (pieces per household per year). That fell by 84.9 (14.4%) from the previous year, FY2019. That fell by 156.0 (23.7%) from five years earlier, FY2015.",
            "metric": "advertising-per-household",
            "years": [
              2020,
              2019,
              2015
            ]
          },
          {
            "text": "In FY2020, Advertising mail received by households was 61,150 (millions of pieces). That fell by 12,011 (16.4%) from the previous year, FY2019. That fell by 18,851 (23.6%) from five years earlier, FY2015.",
            "metric": "advertising-received-total",
            "years": [
              2020,
              2019,
              2015
            ]
          },
          {
            "text": "In FY2020, First-Class advertising received (ads only) was 3,470 (millions of pieces). That fell by 503 (12.7%) from the previous year, FY2019. That fell by 123 (3.4%) from five years earlier, FY2015.",
            "metric": "fcm-received-advertising",
            "years": [
              2020,
              2019,
              2015
            ]
          },
          {
            "text": "In FY2020, Marketing Mail advertising received was 54,867 (millions of pieces). That fell by 10,819 (16.5%) from the previous year, FY2019. That fell by 16,764 (23.4%) from five years earlier, FY2015.",
            "metric": "marketing-mail-ads-received",
            "years": [
              2020,
              2019,
              2015
            ]
          }
        ],
