    "yearly": {
      "section": "Mail volumes and flows",
      "kind": "yearly",
      "fiscal_year": 2020,
      "summary": {
        "headline": "Mail usage by households declined in fiscal year 2020, with decreases in both sent and received First-Class Mail and overall household mail volumes.",
        "statements": [
          {
            "text": "First-Class Mail received per household was 278.1 pieces per household per year in fiscal year 2020, a decrease of 10.7 pieces (-3.7%) from fiscal year 2019 and a decrease of 51.2 pieces (-15.5%) from fiscal year 2015.",
            "metric": "fcm-received-per-household",
            "years": [
              2015,
              2019,
              2020
            ]
          },
          {
            "text": "Total First-Class Mail received by households was 35729.0 millions of pieces in fiscal year 2020, which was 1270.0 millions of pieces (-3.4%) less than in fiscal year 2019 and 5671.0 millions of pieces (-13.7%) less than in fiscal year 2015.",
            "metric": "fcm-received-total",
            "years": [
              2015,
              2019,
              2020
            ]
          },
          {
            "text": "Households sent 50.9 pieces of First-Class Mail per household per year in fiscal year 2020, a drop of 1.3 pieces (-2.5%) from fiscal year 2019 and 26.3 pieces (-34.1%) from fiscal year 2015.",
            "metric": "fcm-sent-per-household",
            "years": [
              2015,
              2019,
              2020
            ]
          },
          {
            "text": "The total volume of First-Class Mail sent by households was 6470.0 millions of pieces in fiscal year 2020, representing a decrease of 198.0 millions of pieces (-3.0%) from fiscal year 2019 and 3389.0 millions of pieces (-34.4%) from fiscal year 2015.",
            "metric": "fcm-sent-total",
            "years": [
              2015,
              2019,
              2020
            ]
          },
          {
            "text": "All household mail per household was 837.0 pieces per household per year in fiscal year 2020, a decrease of 84.8 pieces (-9.2%) from fiscal year 2019 and 203.6 pieces (-19.6%) from fiscal year 2015.",
            "metric": "household-mail-per-household",
            "years": [
              2015,
              2019,
              2020
            ]
          },
          {
            "text": "The total volume of all household mail, sent and received, was 104800.0 millions of pieces in fiscal year 2020, a decrease of 11200.0 millions of pieces (-9.7%) from fiscal year 2019 and 23600.0 millions of pieces (-18.4%) from fiscal year 2015.",
            "metric": "household-mail-total",
            "years": [
              2015,
              2019,
              2020
            ]
          }
        ],
        "caveats": [
          "Data for All household mail per household is missing for fiscal years 2016, 2017, and 2018.",
          "Comparisons involving First-Class Mail received by households, First-Class Mail sent by households, and All household mail, sent and received for fiscal years 2015, 2019, and 2020 should be cautious as these values are from reports published prior to the FY2024 restatement of 2014-2023 data.",
          "Comparisons for All household mail per household between fiscal year 2019 (from the FY2024 report) and fiscal years 2015 and 2020 (from the FY2025 report) should be cautious due to the FY2025 survey redesign."
        ]
