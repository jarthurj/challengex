      "fiscal_year_range": null,
      "summary": {
        "headline": "In fiscal year 2023, advertising mail received per household fell across all reported demographic segments compared to the previous year and five years earlier.",
        "statements": [
          {
            "text": "For all households, advertising mail received per household was 436.8 pieces per household per year in FY2023, falling by 62.4 pieces per household per year from the previous year and falling by 156.0 pieces per household per year from FY2018 across the FY2014 methodology break.",
            "metric": "advertising-mail-received-per-household",
            "years": [
              2014,
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For Under $35K, advertising mail received per household was 254.8 pieces per household per year in FY2023, decreasing by 72.8 pieces per household per year from the previous year and decreasing by 130.0 pieces per household per year from FY2018 across the FY2014 methodology break.",
            "metric": "advertising-mail-received-per-household",
            "years": [
              2014,
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For Over $100K, advertising mail received per household was 551.2 pieces per household per year in FY2023, dropping by 83.2 pieces per household per year from the previous year and dropping by 213.2 pieces per household per year from FY2018 across the FY2014 methodology break.",
            "metric": "advertising-mail-received-per-household",
            "years": [
              2014,
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For Under 35, advertising mail received per household was 202.8 pieces per household per year in FY2023, declining by 67.6 pieces per household per year from the previous year and declining by 140.4 pieces per household per year from FY2018 across the FY2014 methodology break.",
            "metric": "advertising-mail-received-per-household",
            "years": [
              2014,
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For Over 55, advertising mail received per household was 577.2 pieces per household per year in FY2023, decreasing by 62.4 pieces per household per year from the previous year and decreasing by 156.0 pieces per household per year from FY2018 across the FY2014 methodology break.",
            "metric": "advertising-mail-received-per-household",
            "years": [
              2014,
              2018,
              2022,
              2023
            ]
          }
        ],
        "caveats": [
          "Comparisons involving the FY2014 methodology break must be treated with caution as the weighting by home ownership was introduced then."
        ]
      },
