        "statements": [
          {
            "text": "For All households, correspondence-received-per-household was 98.8 pieces per household per year in FY2023, falling from 104.0 pieces per household per year in FY2022 and down from 114.4 pieces per household per year in FY2018, while crossing the FY2017 methodology break.",
            "metric": "correspondence-received-per-household",
            "years": [
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For $35K to $65K, correspondence-received-per-household was 83.2 pieces per household per year in FY2023, decreasing from 104.0 pieces per household per year in FY2022 and dropping from 104.0 pieces per household per year in FY2018 across the FY2017 methodology break.",
            "metric": "correspondence-received-per-household",
            "years": [
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For $65K to $100K, correspondence-received-per-household stood at 109.2 pieces per household per year in FY2023, rising from 104.0 pieces per household per year in FY2022 but falling from 130.0 pieces per household per year in FY2018, crossing the FY2017 methodology break.",
            "metric": "correspondence-received-per-household",
            "years": [
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For College graduate, correspondence-received-per-household reached 98.8 pieces per household per year in FY2023, declining from 109.2 pieces per household per year in FY2022 and from 124.8 pieces per household per year in FY2018 across the FY2017 methodology break.",
            "metric": "correspondence-received-per-household",
            "years": [
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For Over $100K, correspondence-received-per-household was 114.4 pieces per household per year in FY2023, decreasing from 130.0 pieces per household per year in FY2022 and falling from 145.6 pieces per household per year in FY2018 across the FY2017 methodology break.",
            "metric": "correspondence-received-per-household",
            "years": [
              2018,
              2022,
              2023
            ]
          },
          {
            "text": "For Under 35, correspondence-received-per-household registered 62.4 pieces per household per year in FY2023, down from 67.6 pieces per household per year in FY2022 and lower than the 72.8 pieces per household per year recorded in FY2018, crossing the FY2017 methodology break.",
            "metric": "correspondence-received-per-household",
            "years": [
              2018,
              2022,
              2023
            ]
          }
        ],
