            "metric": "transactions-per-household",
            "years": [
              2020,
              2024,
              2025
            ]
          },
          {
            "text": "Households Under 45 had 51.8 pieces per household per year in FY2025, down by 27.9 pieces per household per year (-35.0%) from FY2020, across the FY2024 and FY2025 methodology breaks.",
            "metric": "transactions-per-household",
            "years": [
              2020,
              2024,
              2025
            ]
          },
          {
            "text": "Households 65 and Over had 133.4 pieces per household per year in FY2025, down by 58.1 pieces per household per year (-30.3%) from FY2020, across the FY2024 and FY2025 methodology breaks.",
